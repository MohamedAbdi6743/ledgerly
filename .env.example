# Copy this file to .env and fill in your own values.
# .env is ignored by Git, so your real values never get committed.
# Both Docker Compose and the Spring Boot app read it.

# If port 5441 is taken on your machine, change it in both lines below.
DB_PORT=5441
DB_URL=jdbc:postgresql://localhost:5441/ledgerly
DB_USERNAME=ledgerly
DB_PASSWORD=choose-a-local-password

# Port the app runs on.
APP_PORT=8080
